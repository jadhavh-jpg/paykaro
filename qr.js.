(function(){
  if(!window.PAYMENT_DATA) return;

  const upiURL=`upi://pay?pa=${PAYMENT_DATA.upi}&pn=${encodeURIComponent(PAYMENT_DATA.title)}&am=${PAYMENT_DATA.amount}&cu=INR`;

  QRCode.toCanvas(document.getElementById('qr'),upiURL,{width:220});

  document.getElementById('upiBtn').onclick=function(e){
    e.preventDefault();
    location.href=upiURL;
    document.getElementById('qr').classList.remove('hide');
    document.getElementById('upiError').classList.remove('hide');
  };
})();
