function $(id){return document.getElementById(id)}

function createLink(){
  const file=$('imageFile').files[0];

  const go=(img)=>{
    const p=new URLSearchParams({
      title:$('title').value,
      desc:$('desc').value,
      amount:$('amount').value,
      upi:$('upi').value,
      color:$('color').value,
      image:img||'',
      points:$('points').value,
      seller:$('seller').value,
      whatsapp:$('whatsapp').value,
      group:$('group').value
    });
    window.open("/lp.html?"+p.toString(),"_blank");
  };

  if(file){
    const r=new FileReader();
    r.onload=e=>go(e.target.result);
    r.readAsDataURL(file);
  }else go('');
}

(function(){
  if(!location.search) return;
  const q=new URLSearchParams(location.search);

  document.documentElement.style.setProperty('--theme',q.get('color'));
  $('title').innerText=q.get('title');
  $('desc').innerText=q.get('desc');
  $('amount').innerText=q.get('amount');
  $('seller').innerText=q.get('seller');

  if(q.get('image')){
    $('poster').src=q.get('image');
    $('poster').classList.remove('hide');
  }

  if(q.get('points')){
    q.get('points').split(',').forEach(t=>{
      const d=document.createElement('div');
      d.className='box';
      d.innerText=t.trim();
      $('pointsBox').appendChild(d);
    });
  }

  if(q.get('whatsapp')){
    $('waBtn').href="https://wa.me/"+q.get('whatsapp');
    $('waBtn').classList.remove('hide');
  }
  if(q.get('group')){
    $('groupBtn').href=q.get('group');
    $('groupBtn').classList.remove('hide');
  }

  window.PAYMENT_DATA={upi:q.get('upi'),amount:q.get('amount'),title:q.get('title')};
})();
