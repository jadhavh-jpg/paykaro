function $(id){ return document.getElementById(id); }

document.addEventListener("DOMContentLoaded", () => {

  const btn = $("createBtn");
  if(btn){
    btn.addEventListener("click", createLink);
  }

});

function createLink(){

  // REQUIRED FIELDS CHECK
  if(!$("title") || !$("amount") || !$("upi")){
    alert("Page not loaded correctly");
    return;
  }

  if(!$("title").value || !$("amount").value || !$("upi").value){
    alert("Please fill all required fields");
    return;
  }

  const imageInput = $("imageFile");
  const file = imageInput && imageInput.files ? imageInput.files[0] : null;

  const proceed = (img) => {
    const p = new URLSearchParams({
      title: $("title").value,
      desc: $("desc").value,
      amount: $("amount").value,
      upi: $("upi").value,
      color: $("color").value,
      image: img || "",
      points: $("points").value,
      seller: $("seller").value,
      whatsapp: $("whatsapp").value,
      group: $("group").value
    });

    window.open("/lp.html?" + p.toString(), "_blank");
  };

  if(file){
    const r = new FileReader();
    r.onload = e => proceed(e.target.result);
    r.readAsDataURL(file);
  } else {
    proceed("");
  }
}

/* -------- LANDING PAGE AUTO LOAD -------- */
(function(){
  if(!location.search) return;

  const q = new URLSearchParams(location.search);

  document.documentElement.style.setProperty("--theme", q.get("color") || "#4f46e5");

  if($("title")) $("title").innerText = q.get("title") || "";
  if($("desc")) $("desc").innerText = q.get("desc") || "";
  if($("amount")) $("amount").innerText = q.get("amount") || "";
  if($("seller")) $("seller").innerText = q.get("seller") || "";

  if(q.get("image") && $("poster")){
    $("poster").src = q.get("image");
    $("poster").classList.remove("hide");
  }

  if(q.get("points") && $("pointsBox")){
    q.get("points").split(",").forEach(t=>{
      const d = document.createElement("div");
      d.className = "box";
      d.innerText = t.trim();
      $("pointsBox").appendChild(d);
    });
  }

  if(q.get("whatsapp") && $("waBtn")){
    $("waBtn").href = "https://wa.me/" + q.get("whatsapp");
    $("waBtn").classList.remove("hide");
  }

  if(q.get("group") && $("groupBtn")){
    $("groupBtn").href = q.get("group");
    $("groupBtn").classList.remove("hide");
  }

  window.PAYMENT_DATA = {
    upi: q.get("upi"),
    amount: q.get("amount"),
    title: q.get("title")
  };
})();
